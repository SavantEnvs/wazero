# WebAssembly binary-format tokens (module magic/version, section IDs, value
# types, common import/export name strings) shared by wazero's three targets.
magic="\x00asm"
version1="\x01\x00\x00\x00"
sec_custom="\x00"
sec_type="\x01"
sec_import="\x02"
sec_function="\x03"
sec_table="\x04"
sec_memory="\x05"
sec_global="\x06"
sec_export="\x07"
sec_start="\x08"
sec_element="\x09"
sec_code="\x0a"
sec_data="\x0b"
sec_datacount="\x0c"
functype="\x60"
valtype_i32="\x7f"
valtype_i64="\x7e"
valtype_f32="\x7d"
valtype_f64="\x7c"
valtype_v128="\x7b"
valtype_funcref="\x70"
valtype_externref="\x6f"
exportkind_func="\x00"
exportkind_table="\x01"
exportkind_memory="\x02"
exportkind_global="\x03"
name_module="name"
name_env="env"
name_memory="memory"
name_table="table"
name_global="global"
name_spectest="spectest"
name_wasi="wasi_snapshot_preview1"
